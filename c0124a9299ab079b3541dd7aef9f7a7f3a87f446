      "writtenOn": "2017-12-25T01:52:03Z",
      "side": 1,
      "message": "Agreed, it\u0027s redundant here, but if user gives \"id\" as well as \"name\", should it be an exception? we can see many examples in this project.",
      "parentUuid": "bf8cb3f7_4daaa1d2",
      "range": {
        "startLine": 44,
        "startChar": 0,
        "endLine": 45,
        "endChar": 27
