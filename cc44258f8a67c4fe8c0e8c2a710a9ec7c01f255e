        "id": 8482
      },
      "writtenOn": "2019-02-28T16:23:15Z",
      "side": 1,
      "message": "This makes me think we should pull out everything we added to keystone/tests/unit/protection into a testing library so that everyone can benefit from that pattern",
      "revId": "cc44258f8a67c4fe8c0e8c2a710a9ec7c01f255e",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
