    {
      "key": {
        "uuid": "3f79a3b5_9b2d8c47",
        "filename": "keystone/api/auth.py",
        "patchSetId": 10
      },
      "lineNbr": 329,
      "author": {
        "id": 2903
      },
      "writtenOn": "2018-10-04T20:55:56Z",
      "side": 1,
      "message": "Head must do all the same work because content length, etc must remain the same. The only thing different between GET and HEAD is that there is a body (per the spec).\n\nHere we are just letting flask do the head work by calling GET and modifying the response internally. I\u0027d rather not implement HEAD code separately from GET unless it\u0027s explicitly needed (we have one API like that, where the behavior between GET and HEAD was remarkably different)",
      "parentUuid": "3f79a3b5_c32560c1",
      "revId": "4e9d7011ebc754178a07079bf1076f7e23109b26",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
    },
    {
      "key": {
        "uuid": "3f79a3b5_8e0a081c",
        "filename": "keystone/auth/plugins/token.py",
        "patchSetId": 10
