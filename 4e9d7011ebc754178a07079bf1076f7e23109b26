      "writtenOn": "2018-10-04T19:19:38Z",
      "side": 1,
      "message": "Does it make sense to skip this step for a HEAD call?",
      "revId": "4e9d7011ebc754178a07079bf1076f7e23109b26",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
