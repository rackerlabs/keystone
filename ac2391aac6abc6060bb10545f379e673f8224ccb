      "author": {
        "id": 11022
      },
      "writtenOn": "2016-04-08T03:57:36Z",
      "side": 1,
      "message": "the package name is used during plugin discovery. This means that having \"keystone_\" in the name makes possible for us to run the plugin test using \"tox -e all-plugin -- keystone\".\n\nif we rename to \"tempest_plugin\" we need to put it inside \"keystone/keystone\", otherwise the plugin discovery won\u0027t find it using the command above. (if we put in keystone/, the root is not included during plugin discovery)",
      "parentUuid": "9a061dce_ec0c0eee",
      "revId": "ac2391aac6abc6060bb10545f379e673f8224ccb",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
