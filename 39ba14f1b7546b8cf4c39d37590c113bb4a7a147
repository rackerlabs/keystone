      "writtenOn": "2019-07-17T10:36:13Z",
      "side": 1,
      "message": "Yes, I think domain readers should not need to see the application credentials but domain admin should be able to?",
      "parentUuid": "7faddb67_df2b9c7f",
      "range": {
        "startLine": 36,
        "startChar": 8,
