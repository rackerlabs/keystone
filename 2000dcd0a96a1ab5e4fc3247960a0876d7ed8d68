    {
      "key": {
        "uuid": "1a7b0d38_2ad3f305",
        "filename": "keystone/token/providers/fernet/token_formatters.py",
        "patchSetId": 2
      },
      "lineNbr": 80,
      "author": {
        "id": 13063
      },
      "writtenOn": "2015-12-25T02:18:31Z",
      "side": 1,
      "message": "I am not using six.binary_type() just because I don\u0027t want to change the behavior of decode on python3.\n\non python3:\n\nencode/unpack will return a byte\ndecode/pack will return a str\n\nIf we using six.binary_type():\n\nencode/unpack will return a byte\ndecode/pack will also return a byte.\n\nI am not quite sure whether this will cause some regression if keystone could run on python3 in the future.",
      "parentUuid": "1a7b0d38_c8127c09",
      "revId": "2000dcd0a96a1ab5e4fc3247960a0876d7ed8d68",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
