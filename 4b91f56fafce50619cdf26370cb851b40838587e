      "writtenOn": "2013-12-04T00:11:40Z",
      "side": 1,
      "message": "This mirrors current .get functionality in KVS.  It was added to parrot that but with get_multi, it can be allowed.",
      "parentUuid": "AAAATn/99vw\u003d",
      "revId": "4b91f56fafce50619cdf26370cb851b40838587e",
