      "writtenOn": "2012-06-21T00:50:34Z",
      "side": 1,
      "message": "Wait. I thought we agreed on making PKI token configurable, no?",
      "revId": "a525587251d0904964afe6ab831a1ce881160293",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
