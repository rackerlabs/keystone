    {
      "key": {
        "uuid": "fa98f980_3453ea3a",
        "filename": "keystone/common/cache/_memcache_pool.py",
        "patchSetId": 19
      },
      "lineNbr": 75,
      "author": {
        "id": 2903
      },
      "writtenOn": "2014-09-16T21:13:09Z",
      "side": 1,
      "message": "what is a sane timeout? what do we do in that case? log and continue the wait?",
      "parentUuid": "fa98f980_061b1c1d",
      "revId": "db0de93809561fc1f647d4f5c9d53ddd16d18478",
