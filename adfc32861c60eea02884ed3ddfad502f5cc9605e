      },
      "lineNbr": 685,
      "author": {
        "id": 8116
      },
      "writtenOn": "2014-06-27T20:45:47Z",
      "side": 1,
      "message": "A connection should support switching between identities. unbind should be supported and one needs to verify each time the connection is used it\u0027s bound to the expected identity.",
      "revId": "adfc32861c60eea02884ed3ddfad502f5cc9605e",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
