      "writtenOn": "2014-06-27T20:45:47Z",
      "side": 1,
      "message": "This seems very inefficient. You\u0027re setting and resetting every connection option on every ldap call.",
      "revId": "adfc32861c60eea02884ed3ddfad502f5cc9605e",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
