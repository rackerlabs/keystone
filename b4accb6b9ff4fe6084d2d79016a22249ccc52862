      "writtenOn": "2014-04-08T20:45:19Z",
      "side": 1,
      "message": "We use base64 encoding, wondering where that fits in here? \n\nhttps://github.com/openstack/keystone/blob/master/keystone/common/pemutils.py#L508",
      "revId": "b4accb6b9ff4fe6084d2d79016a22249ccc52862",
