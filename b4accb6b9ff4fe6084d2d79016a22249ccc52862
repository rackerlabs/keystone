        "id": 6482
      },
      "writtenOn": "2014-04-08T21:21:33Z",
      "side": 1,
      "message": "I think that is the intention of the \"Configurable: Yes/No\" section.",
      "parentUuid": "AAAAWn//3f0\u003d",
      "revId": "b4accb6b9ff4fe6084d2d79016a22249ccc52862",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
