    {
      "key": {
        "uuid": "AAAAW3///ZY\u003d",
        "filename": "doc/source/security_details.rst",
        "patchSetId": 2
      },
      "lineNbr": 45,
      "author": {
        "id": 9098
      },
      "writtenOn": "2014-04-09T01:26:41Z",
      "side": 1,
      "message": "Base64 encoding does not count as encryption.  It really should be thought of as plain text, as it provides zero security.  Think of it the same as representing characters as Unicode escape sequences instead of ASCII to represent strings (\"ABC\" \u003d \"\\u0041\\u0042\\u0043\").\n\nThere is no purpose in calling out base64 in this document.",
      "parentUuid": "AAAAWn//3pQ\u003d",
      "revId": "b4accb6b9ff4fe6084d2d79016a22249ccc52862",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
    },
