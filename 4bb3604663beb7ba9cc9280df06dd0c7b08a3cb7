    {
      "key": {
        "uuid": "5f7c97a3_b74a0480",
        "filename": "keystone/limit/models/strict_two_level.py",
        "patchSetId": 17
      },
      "lineNbr": 57,
      "author": {
        "id": 5046
      },
      "writtenOn": "2018-07-09T20:26:47Z",
      "side": 1,
      "message": "Per the comment below, I wonder if we should just make this the interface instead of requiring enforcement models to accept data structures specific to the unified limit API (even though they are tightly coupled).",
      "range": {
        "startLine": 57,
        "startChar": 8,
        "endLine": 57,
        "endChar": 20
      },
      "revId": "4bb3604663beb7ba9cc9280df06dd0c7b08a3cb7",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
