      "writtenOn": "2016-07-22T06:54:53Z",
      "side": 1,
      "message": "I think it is not make sense to update a user with an empty body, I am okay to not mention \u0027minProperties\u0027 here.",
      "parentUuid": "dada55a8_a8a61cbe",
      "revId": "eafcb217eb7b437776fe0d385b6bb55fd5d4be47",
