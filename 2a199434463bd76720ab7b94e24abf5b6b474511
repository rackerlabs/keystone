    {
      "key": {
        "uuid": "fa98f980_7309dadc",
        "filename": "keystone/contrib/federation/idp.py",
        "patchSetId": 52
      },
      "lineNbr": 399,
      "author": {
        "id": 8978
      },
      "writtenOn": "2014-09-01T22:13:29Z",
      "side": 1,
      "message": "id is a xml tag with a certain value assigned to it for a unique identification. \u003cSignature\u003e \u0027template\u0027 should be filled with \u0027#\u0027\u003cid-tag-value\u003e so only this particular part instead of the whole XML is signed. We want to sign \u003cAssertion\u003e only. ID or id need to be specified to the xmlsec1 binary so it can properly parse and find XML objects.\n\nHowever, since we can predict what will the tag name be (\u0027ID\u0027, not \u0027id\u0027 nor \u0027Id\u0027) we can enforce name in the command_list and therefore remove this subfunction.",
      "parentUuid": "fa98f980_161eca70",
      "revId": "2a199434463bd76720ab7b94e24abf5b6b474511",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
    },
