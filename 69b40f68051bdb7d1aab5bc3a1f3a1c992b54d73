      "writtenOn": "2016-08-17T19:41:05Z",
      "side": 1,
      "message": "I like the idea, however the point of a backend performing the encryption for us is valid. Please amend the description as suggested by Dolph.",
      "parentUuid": "3ac371cc_11019d05",
      "revId": "69b40f68051bdb7d1aab5bc3a1f3a1c992b54d73",
