PRAGMA foreign_keys=OFF;
BEGIN TRANSACTION;
CREATE TABLE users (
	created_at DATETIME, 
	updated_at DATETIME, 
	deleted_at DATETIME, 
	deleted BOOLEAN, 
	id VARCHAR(255) NOT NULL, 
	name VARCHAR(255), 
	access_key VARCHAR(255), 
	secret_key VARCHAR(255), 
	is_admin BOOLEAN, 
	PRIMARY KEY (id), 
	CHECK (is_admin IN (0, 1)), 
	CHECK (deleted IN (0, 1))
);
INSERT INTO "users" VALUES('2012-02-13 23:40:46.389614',NULL,NULL,0,'testuser',NULL,'myaccess','mysecret',0);
