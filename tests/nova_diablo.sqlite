INSERT INTO "users" VALUES('2012-02-13 23:41:03.594911',NULL,NULL,1,'testdeleted',NULL,'myaccess','mysecret',1);
CREATE TABLE projects (
	created_at DATETIME, 
	updated_at DATETIME, 
	deleted_at DATETIME, 
	deleted BOOLEAN, 
	id VARCHAR(255) NOT NULL, 
	name VARCHAR(255), 
	description VARCHAR(255), 
	project_manager VARCHAR(255), 
	PRIMARY KEY (id), 
	CHECK (deleted IN (0, 1)), 
	FOREIGN KEY(project_manager) REFERENCES users (id)
);
INSERT INTO "projects" VALUES('2012-02-13 23:41:47.478720',NULL,NULL,0,'userproject','userproject','mydescription','testuser');
INSERT INTO "projects" VALUES('2012-02-13 23:41:47.478720',NULL,NULL,0,'adminproject','adminproject','mydescription','testadmin');
