        "id": 708
      },
      "writtenOn": "2014-02-04T10:54:51Z",
      "side": 1,
      "message": "Yes, this filter should definitely work on server-side. There might be something off with timezones or time representation though.",
      "revId": "5e7de54cff8d4a47362b6e5e837e7b489a5c4c2d",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
