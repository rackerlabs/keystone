    {
      "key": {
        "uuid": "AAAARn//unk\u003d",
        "filename": "keystone/notifications.py",
        "patchSetId": 11
      },
      "lineNbr": 91,
      "author": {
        "id": 5046
      },
      "writtenOn": "2013-08-22T18:17:48Z",
      "side": 1,
      "message": "We can\u0027t optionally pass the context since it is required by the notifier api in Oslo-incubator. We also want to implement this in the Manager to avoid implementing the same notification in all the drivers/backends. \n\nSee dolphm\u0027s explaination in the previous patch sets. He suggested the notification call be implemented in the Manager for this reason. Since there is no context available in the Mangers we have to build one. ayoung, stevemar, and I talked about this in IRC and ayoung suggested that we just pass an empty context since it doesn\u0027t effect Keystone that much to send it anyway.",
      "parentUuid": "AAAARn//xzU\u003d",
      "revId": "652d5bd1cf10c8c5719c0d59e0e7238ea263205e",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
