    {
      "key": {
        "uuid": "7f96bb07_4068aa1b",
        "filename": "keystone/application_credential/core.py",
        "patchSetId": 34
      },
      "lineNbr": 86,
      "author": {
        "id": 8482
      },
      "writtenOn": "2018-01-17T19:25:29Z",
      "side": 1,
      "message": "It should not be possible if they go through the REST API. If the user doesn\u0027t specify a role in their request then the roles are taken from the token. They can\u0027t do this with an unscoped token so there will always be a role.\n\nHowever, if someone is trying to write some kind of plugin and not going through the REST API then I guess they could hit this, can add a guard.",
      "parentUuid": "7f96bb07_1aca151a",
      "revId": "39f2241ea8800292e9a11a80a6e8ee85f06b51d8",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
