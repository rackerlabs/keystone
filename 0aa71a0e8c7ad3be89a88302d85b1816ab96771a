      "side": 1,
      "message": "How come this doesn\u0027t fail the uniqueness constraint?",
      "range": {
        "startLine": 2610,
        "startChar": 55,
        "endLine": 2611,
        "endChar": 66
      },
      "revId": "0aa71a0e8c7ad3be89a88302d85b1816ab96771a",
