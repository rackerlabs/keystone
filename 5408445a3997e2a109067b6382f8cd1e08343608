      "writtenOn": "2017-01-18T21:47:32Z",
      "side": 1,
      "message": "Why don\u0027t we need this anymore? User IDs should be unique whether or not they are in the user table or the local_user table or the nonlocal_user table, right?",
      "revId": "5408445a3997e2a109067b6382f8cd1e08343608",
