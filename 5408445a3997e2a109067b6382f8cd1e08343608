    {
      "key": {
        "uuid": "5a3905b3_2dc16d81",
        "filename": "keystone/common/sql/contract_repo/versions/014_contract_add_domain_id_to_user.py",
        "patchSetId": 38
      },
      "lineNbr": 30,
      "author": {
        "id": 18338
      },
      "writtenOn": "2017-01-19T01:36:53Z",
      "side": 1,
      "message": "User IDs will be unique, but now I\u0027m combining it with the domain_id to create a composite foreign key constraint. Thus, user_id + domain_id will still enforce uniqueness in the local_user and nonlocal_user tables. So the current fk is not needed and I don\u0027t think you can have multiple fk constraints on the same column.",
      "parentUuid": "7a3c09a3_641c6314",
      "revId": "5408445a3997e2a109067b6382f8cd1e08343608",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
