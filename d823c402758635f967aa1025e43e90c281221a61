    {
      "key": {
        "uuid": "7f96bb07_8d282a97",
        "filename": "keystone/common/policies/application_credential.py",
        "patchSetId": 33
      },
      "lineNbr": 24,
      "author": {
        "id": 5046
      },
      "writtenOn": "2018-01-17T20:55:45Z",
      "side": 1,
      "message": "For system administrators - they should be able to get any application credential? But for project administrators, they should only be able to get application credentials for the project they are an administrator on.\n\nJust making a note about that here so that we can follow this up with a FIXME for later.",
      "range": {
        "startLine": 24,
        "startChar": 8,
        "endLine": 24,
        "endChar": 19
      },
      "revId": "d823c402758635f967aa1025e43e90c281221a61",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
    },
    {
      "key": {
        "uuid": "7f96bb07_43e3d1d9",
