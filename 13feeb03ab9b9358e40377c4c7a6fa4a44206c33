        "uuid": "7faddb67_48b64d8d",
        "filename": "doc/source/admin/caching-layer.rst",
        "patchSetId": 1
      },
      "lineNbr": 92,
      "author": {
        "id": 1916
      },
      "writtenOn": "2019-07-22T22:53:39Z",
      "side": 1,
      "message": "I am not sure if this statement is true. It all depends on the order in which the memcache ring is specified. Say if you have 3 Keystone instances and the memcache order is \"memcache1,memcache2,memcache3\" configured on all three, all three Keystone instances will see the data the same way.",
      "range": {
        "startLine": 90,
        "startChar": 1,
        "endLine": 92,
        "endChar": 34
      },
      "revId": "13feeb03ab9b9358e40377c4c7a6fa4a44206c33",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
