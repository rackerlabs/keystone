    },
    {
      "key": {
        "uuid": "7faddb67_759e4f08",
        "filename": "doc/source/admin/caching-layer.rst",
        "patchSetId": 1
      },
      "lineNbr": 92,
      "author": {
        "id": 5046
      },
      "writtenOn": "2019-07-25T15:07:44Z",
      "side": 1,
      "message": "Correct, that is what I was trying to relay.\n\nIn this example, I\u0027m trying to say that if each keystone node is only configured to use local caching, then round trips will be required even if one keystone node cached that user already.\n\nI attempt to describe the \"sharded\" approach on the next line.",
      "parentUuid": "7faddb67_48b64d8d",
      "range": {
        "startLine": 90,
        "startChar": 1,
        "endLine": 92,
        "endChar": 34
      },
      "revId": "13feeb03ab9b9358e40377c4c7a6fa4a44206c33",
