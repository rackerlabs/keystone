      "unresolved": false
    },
    {
      "key": {
        "uuid": "7a8ec9b2_76776dd4",
        "filename": "keystone/conf/saml.py",
        "patchSetId": 1
      },
      "lineNbr": 66,
      "author": {
        "id": 7725
      },
      "writtenOn": "2016-09-20T14:00:37Z",
      "side": 1,
      "message": "I don\u0027t like defaults that are actually broken. If we don\u0027t need this then we shouldn\u0027t make it required and leave the default None. If this is required (I think it is for federation) then it should be checked somewhere (maybe only in doctor) to make sure it has a value.",
      "revId": "08c8a721379f5bb409e22aab5937a11825954d89",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
    },
    {
      "key": {
        "uuid": "7a8ec9b2_d4dd8043",
        "filename": "keystone/conf/saml.py",
