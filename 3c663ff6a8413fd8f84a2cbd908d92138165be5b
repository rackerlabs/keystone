    {
      "key": {
        "uuid": "AAAAQn//kUI\u003d",
        "filename": "keystone/contrib/delegated_auth/core.py",
        "patchSetId": 44
      },
      "lineNbr": 339,
      "author": {
        "id": 2903
      },
      "writtenOn": "2013-07-28T23:01:13Z",
      "side": 1,
      "message": "You need to make sure that only the tokens for the OAuth consumer are deleted.  The top level _delete_tokens_for_user is a very, very wide net to cast and will invalidate _all_ tokens for the user.  There has been changes to limit this to tenant and/or trust.  I am fairly certain we don\u0027t want to delete _every_ active token for the user, but only ones pertaining to the OAuth Consumer.",
      "revId": "3c663ff6a8413fd8f84a2cbd908d92138165be5b",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
    },
