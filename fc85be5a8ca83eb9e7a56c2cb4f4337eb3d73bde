    {
      "key": {
        "uuid": "dab17558_a329259d",
        "filename": "keystone/common/config.py",
        "patchSetId": 1
      },
      "lineNbr": 1030,
      "author": {
        "id": 6482
      },
      "writtenOn": "2016-05-11T20:21:47Z",
      "side": 1,
      "message": "this seems like an easy check to do in the code, and gives us added safety of this not being on by default. i\u0027m totally okay with this, do you have an alternative?",
      "parentUuid": "dab17558_318ade1b",
      "range": {
        "startLine": 1030,
        "startChar": 21,
        "endLine": 1030,
        "endChar": 27
      },
      "revId": "fc85be5a8ca83eb9e7a56c2cb4f4337eb3d73bde",
