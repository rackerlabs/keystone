      "writtenOn": "2016-05-17T17:49:11Z",
      "side": 1,
      "message": "I think we need to agree on defaults for these settings.  90 days seems too short for the default.",
      "range": {
        "startLine": 1031,
        "startChar": 27,
        "endLine": 1031,
        "endChar": 29
      },
      "revId": "45f8a554f033c626e8191134be299c8819ed5366",
