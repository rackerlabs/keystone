      "side": 1,
      "message": "Is it just me, or do these steps correspond to normal use of App. Credentials without OAuth2? Where is the difference?",
      "revId": "3fec3b863e144573dc4d9c17b541cf606d271561",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543"
