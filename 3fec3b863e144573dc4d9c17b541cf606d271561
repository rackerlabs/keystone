      },
      "writtenOn": "2022-08-05T15:49:18Z",
      "side": 1,
      "message": "I would recommend HTTPS in both cases. I\u0027m not aware of any issues connecting to HTTPS endpoints using openstack clients. But it\u0027s just a nit.",
      "range": {
        "startLine": 35,
        "startChar": 18,
        "endLine": 38,
        "endChar": 10
      },
      "revId": "3fec3b863e144573dc4d9c17b541cf606d271561",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "f5dc3c6d_e058b70a",
