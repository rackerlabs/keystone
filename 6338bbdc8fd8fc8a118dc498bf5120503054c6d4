    {
      "key": {
        "uuid": "AAAAEn//39E\u003d",
        "filename": "keystone/common/sql/nova.py",
        "patchSetId": 5
      },
      "lineNbr": 15,
      "author": {
        "id": 1132
      },
      "writtenOn": "2012-02-22T02:40:24Z",
      "side": 1,
      "message": "This is a simple migration - there\u0027s one method that accepts a dictionary of data and does a very specific thing with it. I find shared state in processes like this to add to the confusion. It might not seem ugly (in thought) to create a class with shared dictionaries and have each internal method look to those, but if I kept this code and used global dictionaries to share state, everybody would be up in arms about it (even though they\u0027re roughly equivalent for our purpose here). I think this approach is much more straightforward, and I\u0027ve broken up each logical subroutine to make it easy to follow.",
      "parentUuid": "AAAAEn//4CY\u003d",
      "revId": "6338bbdc8fd8fc8a118dc498bf5120503054c6d4",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
