      "writtenOn": "2017-01-12T09:50:13Z",
      "side": 1,
      "message": "Spec says the roles would be created, likewise to the projects.\n\n\"If any of those projects or roles do not exist, they must be created by Keystone automatically.\"\n\nhttps://specs.openstack.org/openstack/keystone-specs/specs/keystone/ocata/shadow-mapping.html",
      "range": {
        "startLine": 130,
        "startChar": 16,
        "endLine": 132,
        "endChar": 53
      },
      "revId": "545f20444fdc1d35528dde06ffdf34c609187cf5",
