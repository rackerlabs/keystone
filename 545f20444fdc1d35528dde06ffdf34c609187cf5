    {
      "key": {
        "uuid": "9a57fde8_4a404957",
        "filename": "keystone/auth/plugins/mapped.py",
        "patchSetId": 8
      },
      "lineNbr": 132,
      "author": {
        "id": 5046
      },
      "writtenOn": "2017-01-12T15:12:35Z",
      "side": 1,
      "message": "I believe there was a discussion sometime before the implementation started happening to see if that was really something we wanted to do.\n\nI think the main point was that deployers would still have to make policy changes across their deployment in order for the role to be useful, and if they have to do that, it would just make sense for them to create the role, too. This is probably something they\u0027d work out using configuration management. This isn\u0027t the case with projects since we can get the domain ID that they should be in the from the identity provider (thanks to Ron!).\n\nI can propose a patch to amend the spec if everyone is on board with that limitation.",
      "parentUuid": "9a57fde8_a3301209",
      "revId": "545f20444fdc1d35528dde06ffdf34c609187cf5",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
    },
