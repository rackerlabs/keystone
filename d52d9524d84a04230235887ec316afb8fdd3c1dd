        "id": 1916
      },
      "writtenOn": "2016-01-27T22:53:05Z",
      "side": 1,
      "message": "I think we should remove this restriction altogether. Role name has no meaning. \u0027admin\u0027 means only what the particular policy.json want it to mean.",
      "parentUuid": "7a5de9d1_3fca97a2",
      "revId": "d52d9524d84a04230235887ec316afb8fdd3c1dd",
