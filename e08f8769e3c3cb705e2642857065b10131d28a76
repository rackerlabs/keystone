    {
      "key": {
        "uuid": "fa98f980_9e7c7722",
        "filename": "keystone/contrib/federation/idp.py",
        "patchSetId": 19
      },
      "lineNbr": 478,
      "author": {
        "id": 4
      },
      "writtenOn": "2014-09-02T04:11:10Z",
      "side": 1,
      "message": "did you mean to use get_cert here?",
      "revId": "e08f8769e3c3cb705e2642857065b10131d28a76",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
