    {
      "key": {
        "uuid": "AAAASX//5d0\u003d",
        "filename": "keystone/notifications.py",
        "patchSetId": 14
      },
      "lineNbr": 60,
      "author": {
        "id": 5046
      },
      "writtenOn": "2013-08-24T04:13:37Z",
      "side": 1,
      "message": "Having the methods notify_created(), notify_updated(), and notify_deleted() was suggested in an early patch set, discussed between morganfainberg and stevemar. Doing this seemed like a better solution than the first implementation where the event_type was determined by what was passed in (see the early implementation).\n\nSo the main reason why this was changed was because this is easier to read and if the construction of event_type is moved to _send_notification then we have to have some logic in there to determine the difference between \u0027identity.resource.created\u0027, \u0027identity.resource.updated\u0027 and \u0027identity.resource.deleted\u0027, which somewhat brings us back to square one with the early implementations.",
      "parentUuid": "AAAASX//58c\u003d",
      "revId": "15114d086a2a71e4d533e87d7de254fb978d8ab6",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
