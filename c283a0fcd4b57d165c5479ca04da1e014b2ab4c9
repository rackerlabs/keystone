        "uuid": "ffe62b97_235ebb43",
        "filename": "keystone/identity/backends/sql_model.py",
        "patchSetId": 13
      },
      "lineNbr": 164,
      "author": {
        "id": 2903
      },
      "writtenOn": "2017-03-28T20:40:19Z",
      "side": 1,
      "message": "Users with old passwords will still be able to validate their passwords, even if they have not changed.\n\nThis option is only telling keystone to continue placing the old password with the less-secure hashing in the DB. The old-hash column (password_ref.password) is only used by Keystones that predate Pike. This option is only needed if you are running Pike Keystones and Pre-Pike keystones in a rolling-upgrade.\n\nSo, I am assuming we are only supporting running Pike with Ocata keystones during a rolling upgrade, not a Queens Keystone and an Ocata keystone on the same DB backend.\n\n\nTL;DR: This is only used during rolling upgrades. User passwords that have not been changed will still validate. That is a core design of this code: do not break users if a password is not changed (that is an operator choice).",
      "parentUuid": "ffe62b97_5c083527",
      "range": {
        "startLine": 162,
        "startChar": 0,
        "endLine": 164,
        "endChar": 76
      },
      "revId": "c283a0fcd4b57d165c5479ca04da1e014b2ab4c9",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
    },
    {
      "key": {
