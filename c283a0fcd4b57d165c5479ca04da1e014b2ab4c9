      "author": {
        "id": 2903
      },
      "writtenOn": "2017-03-28T20:40:19Z",
      "side": 1,
      "message": "We could. This is just verifying that the compat hash is not generated. It would be a different test case if we want to test all password hashing options we have.",
      "parentUuid": "ffe62b97_a8e01f98",
      "revId": "c283a0fcd4b57d165c5479ca04da1e014b2ab4c9",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
