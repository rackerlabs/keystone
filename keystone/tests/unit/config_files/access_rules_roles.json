{
    "identity": [
        {
            "path": "/v3/groups",
            "method": "GET",
            "roles": [
                "reader",
                "admin"
            ]
        },
        {
            "path": "/v3/groups",
            "method": "POST",
            "roles": [
                "admin"
            ]
        },
        {
            "path": "/v3/groups/*",
            "method": "GET",
