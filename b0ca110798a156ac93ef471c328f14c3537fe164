    {
      "key": {
        "uuid": "7f96bb07_7cbc1505",
        "filename": "keystone/tests/unit/application_credential/test_backends.py",
        "patchSetId": 27
      },
      "lineNbr": 57,
      "author": {
        "id": 8482
      },
      "writtenOn": "2018-01-11T20:45:44Z",
      "side": 1,
      "message": "Nope. An app cred needs to be uniquely identifiable, either by ID alone, or by user + name. Since app creds belong to users, not projects, it only makes sense for them to be unique by name for a user. We agreed to this in the spec: \"name must be unique among a User’s application credentials, but name is only guaranteed to be unique under that User. name may be useful for Consumers who want human readable config files.\" http://specs.openstack.org/openstack/keystone-specs/specs/keystone/queens/application-credentials.html#application-credential-management",
      "parentUuid": "7f96bb07_f1260eb8",
      "revId": "b0ca110798a156ac93ef471c328f14c3537fe164",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
    },
