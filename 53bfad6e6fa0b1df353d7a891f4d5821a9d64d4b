    {
      "key": {
        "uuid": "9a68dd71_2e6146a9",
        "filename": "keystone/common/cache/_context_cache.py",
        "patchSetId": 2
      },
      "lineNbr": 48,
      "author": {
        "id": 2903
      },
      "writtenOn": "2016-01-25T19:39:51Z",
      "side": 1,
      "message": "This change set has nothing to do with cross-thread caching. This is in place so we capture any queries to the backend and cache it local to the request itself.\n\nWhat this means is that if we ask for .get_domain(domain_id), it will only ever happen a single time for the request as the rest of the time it will reference the value stored in context.get_current() [thread.local]. The only exception to this is if an invalidation of the cache occurs (an explicit update to domain_id/domain/etc) as that would pop the underlying cache as well we clear our thread.local at the same time if it has been cached.\n\nThe crossworker invalidations is a different changeset.",
      "parentUuid": "9a68dd71_f3a9d790",
      "range": {
        "startLine": 48,
        "startChar": 0,
        "endLine": 48,
        "endChar": 46
      },
