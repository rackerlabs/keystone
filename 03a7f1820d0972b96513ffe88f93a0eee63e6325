      "unresolved": false
    },
    {
      "key": {
        "uuid": "baada198_ee0dab90",
        "filename": "keystone/common/ldap/core.py",
        "patchSetId": 13
      },
      "lineNbr": 726,
      "author": {
        "id": 708
      },
      "writtenOn": "2014-07-18T10:30:58Z",
      "side": 1,
      "message": "I don\u0027t think this would work if we run search_ext in one connection and then result3 in another one.\n\nYou should probably encode smth into msgid returned by search_ext. For example, you can do smth like this:\n\n    class MsgId(list): pass\n\n    def search_ext(...):\n        conn_mgr \u003d conn_pool.connection(...)\n        conn \u003d conn_mgr.__enter__()\n        try:\n            msgid \u003d conn.search_ext(...)\n        except:\n            conn_mgr.__exit__(*sys.exc_info())\n            raise\n        res \u003d MsgId((conn, msgid))\n        weakref.ref(res, functools.partial(conn_mgr.__exit__, None, None, None))\n        return res\n\n    def result3(...):\n        conn, msgid \u003d msgid\n        return conn.result3(msgid, ...)\n\nThis will release connection once last reference to MsgId object is freed (basically when the method that called it finishes).",
      "range": {
        "startLine": 726,
        "startChar": 8,
        "endLine": 726,
        "endChar": 15
      },
      "revId": "03a7f1820d0972b96513ffe88f93a0eee63e6325",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
    },
