    {
      "key": {
        "uuid": "baada198_4a790392",
        "filename": "keystone/common/ldap/core.py",
        "patchSetId": 13
      },
      "lineNbr": 687,
      "author": {
        "id": 1091
      },
      "writtenOn": "2014-07-19T01:36:58Z",
      "side": 1,
      "message": "If LDAP connection password needs to be changed, keystone configuration needs to be updated and possibly server needs to restart to make configuration change effective. So pool dynamic reconfig is not needed here and supported elsewhere in keystone.",
      "parentUuid": "baada198_77ffaa02",
      "revId": "03a7f1820d0972b96513ffe88f93a0eee63e6325",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
    },
    {
      "key": {
