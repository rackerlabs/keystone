      "author": {
        "id": 708
      },
      "writtenOn": "2014-07-18T10:30:58Z",
      "side": 1,
      "message": "Note that who and cred are encoded here. You should probably do the same.\n\nUPD: Or better use KeystoneLDAPHandler(conn) everywhere so that all these processing steps happens for all methods.",
      "range": {
        "startLine": 803,
