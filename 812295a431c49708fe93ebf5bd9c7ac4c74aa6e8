    },
    {
      "key": {
        "uuid": "AAAAVX//rvE\u003d",
        "filename": "keystone/token/providers/common.py",
        "patchSetId": 63
      },
      "lineNbr": 469,
      "author": {
        "id": 2218
      },
      "writtenOn": "2014-03-01T06:22:38Z",
      "side": 1,
      "message": "This is necessary to enforce that the revocation events are actually doing their job.  If the token is deleted from the back end, it won\u0027t be found when user attempts to authenticate, making the revocation events untestable.",
      "parentUuid": "AAAAVX//tvI\u003d",
