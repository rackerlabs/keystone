    {
      "key": {
        "uuid": "AAAAVX//ru0\u003d",
        "filename": "keystone/token/providers/common.py",
        "patchSetId": 63
      },
      "lineNbr": 467,
      "author": {
        "id": 2218
      },
      "writtenOn": "2014-03-01T06:22:38Z",
      "side": 1,
      "message": "This is the right scope:  revoking a token means that we should revoke all tokens for that user that have the same expiration, as that means all fruit from the same tree:  anything more narrow and we miss tokens that should be revoked.",
      "parentUuid": "AAAAVX//tvQ\u003d",
      "revId": "812295a431c49708fe93ebf5bd9c7ac4c74aa6e8",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
