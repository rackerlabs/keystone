      },
      "writtenOn": "2014-02-28T20:21:47Z",
      "side": 1,
      "message": "seems like you should call delete token either way -- why make it conditional?",
      "revId": "812295a431c49708fe93ebf5bd9c7ac4c74aa6e8",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
