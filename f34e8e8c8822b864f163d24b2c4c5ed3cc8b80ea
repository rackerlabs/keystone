    {
      "key": {
        "uuid": "AAAAPX//4nk\u003d",
        "filename": "keystone/token/provider.py",
        "patchSetId": 14
      },
      "lineNbr": 406,
      "author": {
        "id": 1916
      },
      "writtenOn": "2013-06-06T18:53:00Z",
      "side": 1,
      "message": "We have to use two managers here because we are supporting V2 an V3 APIs at the same time. Furthermore, for PKI tokens, they can not be manipulated once is signed. That\u0027s the reason we have to use two separate providers instead of translating them in middleware.",
      "parentUuid": "AAAAPX//41Q\u003d",
      "revId": "f34e8e8c8822b864f163d24b2c4c5ed3cc8b80ea",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
    },
