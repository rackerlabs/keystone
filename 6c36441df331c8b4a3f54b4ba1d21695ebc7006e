    {
      "key": {
        "uuid": "5f7c97a3_24f9d37e",
        "filename": "keystone/common/rbac_enforcer/enforcer.py",
        "patchSetId": 19
      },
      "lineNbr": 240,
      "author": {
        "id": 2903
      },
      "writtenOn": "2018-06-26T22:01:53Z",
      "side": 1,
      "message": "This is to support the concept of the enforcer being locally instantiated ahead of the game. It is currently for testing but it may help to save some overhead in the grand scheme of things if each API or each resource has it\u0027s own enforcer.\n\nI was envisioning the resource base having self.enforcer instantiated and implementing a .enforce_call that passes self.enforcer as the enforcer argument.\n\nI wanted to allow both to work in the case that something had to call enforce and didn\u0027t want to pre-instantiate (wasn\u0027t a resource object) an enforcer.\n\nFor now everything is on-demand.",
      "parentUuid": "5f7c97a3_49cae86d",
      "range": {
        "startLine": 239,
        "startChar": 0,
        "endLine": 240,
        "endChar": 45
      },
