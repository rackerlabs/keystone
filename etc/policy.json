    "identity:revoke_grant": "rule:cloud_admin or rule:domain_admin_for_grants or rule:project_admin_for_grants",

    "admin_on_domain_filter" : "rule:cloud_admin or (role:cloud_admin and domain_id:%(scope.domain.id)s)",
