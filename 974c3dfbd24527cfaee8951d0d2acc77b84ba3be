      "writtenOn": "2016-06-29T17:11:24Z",
      "side": 1,
      "message": "What is the process for rotating the keys?",
      "revId": "974c3dfbd24527cfaee8951d0d2acc77b84ba3be",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
