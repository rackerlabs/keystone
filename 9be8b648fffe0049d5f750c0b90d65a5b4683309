        "id": 6482
      },
      "writtenOn": "2014-05-29T16:28:06Z",
      "side": 1,
      "message": "I remember reading somewhere that this was OK to do if you\u0027re doing implicit authorization... let me dig it up. Can\u0027t find it in the spec atm.",
      "parentUuid": "3ae8d1ca_1c8f98cd",
      "revId": "9be8b648fffe0049d5f750c0b90d65a5b4683309",
