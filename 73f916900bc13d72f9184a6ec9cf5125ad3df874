    {
      "key": {
        "uuid": "1ae5cdf2_f025d3ae",
        "filename": "keystone/tests/test_backend_sql.py",
        "patchSetId": 4
      },
      "lineNbr": 346,
      "author": {
        "id": 2903
      },
      "writtenOn": "2014-06-09T16:39:02Z",
      "side": 1,
      "message": "If you look at the context manager, the part up to \u0027yield\u0027 is executed before the block within the \u0027with\u0027 statement, and the part after yield is executed once you\u0027re out of the with statement.\n\nthis could be accomplished with a try/finally (context managers are just nice syntactic sugar)",
      "parentUuid": "1ae5cdf2_00a20d9a",
      "revId": "73f916900bc13d72f9184a6ec9cf5125ad3df874",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
    },
    {
      "key": {
