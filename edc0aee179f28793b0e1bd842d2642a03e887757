      "writtenOn": "2022-03-09T06:51:24Z",
      "side": 1,
      "message": "Test code has been added to check whether the response contains these three attributes. Because no way to properly mock token_id was found, access_token value was not checked.",
      "parentUuid": "2865aa86_2ddc6254",
      "revId": "edc0aee179f28793b0e1bd842d2642a03e887757",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543"
