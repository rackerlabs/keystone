      "writtenOn": "2013-10-30T11:50:51Z",
      "side": 1,
      "message": "Do you really need to wrap something as common and non-base64-specific as quote/unquote?",
      "revId": "1f872abb80c262e10730d86d1ef068bda0dea989",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
      "unresolved": false
