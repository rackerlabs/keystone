    {
      "key": {
        "uuid": "5f7c97a3_5f447e19",
        "filename": "keystone/common/sql/expand_repo/versions/046_expand_add_capability_tables.py",
        "patchSetId": 1
      },
      "lineNbr": 84,
      "author": {
        "id": 12542
