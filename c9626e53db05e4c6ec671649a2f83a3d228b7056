      "writtenOn": "2018-06-06T15:04:57Z",
      "side": 1,
      "message": "I might not be understanding something completely, but these last two tables seem to have a lot in common. Is there an advantage to keeping them separated?",
      "revId": "c9626e53db05e4c6ec671649a2f83a3d228b7056",
      "serverId": "4a232e18-c5a9-48ee-94c0-e04e7cca6543",
